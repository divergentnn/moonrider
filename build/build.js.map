module.exports = "varying vec2 uvs;\nuniform vec3 color1;\nuniform vec3 color2;\n\nvoid main () {\n  float mixDistance = distance(uvs, vec2(0.5, 0));\n  float alphaDistance = min(1., (0.5 - distance(uvs, vec2(0.5))) * 2.5);\n  gl_FragColor = vec4(mix(color1, color2, pow(mixDistance, 2.4)), alphaDistance);\n}\n"