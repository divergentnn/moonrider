module.exports = "uniform float time;\nvarying vec2 uvs;\nvoid main() {\n  uvs.xy = uv.xy;\n  float t = time * 0.0005;\n  vec3 pos = position;\n  pos.y += sin(t + uv.x * 3.0 + pos.x * 0.01) * 20.0;\n  pos.y += sin(-t * 1.3 + uv.x * 7.0 + pos.x * 0.008) * 10.0;\n  gl_Position = projectionMatrix * modelViewMatrix * vec4( pos, 1.0 );\n}"